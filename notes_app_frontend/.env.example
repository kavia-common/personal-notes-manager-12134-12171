# PUBLIC INTERFACE ENVIRONMENT VARIABLES
# Configure the backend API base URL and site URL here. Do not commit real credentials.
# The orchestrator will populate the actual .env for deployments.

# PUBLIC_INTERFACE
# API base URL of the backend notes service (e.g., http://localhost:8000 or https://api.example.com)
VITE_API_BASE_URL=http://localhost:8000

# PUBLIC_INTERFACE
# Site URL used for redirects (if applicable)
VITE_SITE_URL=http://localhost:3000
